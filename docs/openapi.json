{
  "openapi": "3.1.0",
  "info": {
    "title": "Google Uzbek Voice Agent",
    "description": "\nREST control surface + realtime WebSocket voice pipeline for the Uzbek\nfarming voice assistant (Gemini Live realtime, or staged Cloud STT uz-UZ →\nGemini → TTS).\n\n### Authentication\n* **REST** — device-scoped: endpoints take a `user_id` (stable per-install\n  device UUID) and never reveal other devices' data. No further auth here;\n  in production nginx fronts the service.\n* **`POST /chats/{chat_id}/agronom-review`** — expert-only, gated by the\n  `X-Agronom-Token` header.\n* **`WS /ws/voice`** — optional token gate: when `VOICE_API_TOKEN` is set the\n  client must connect with `?token=…` (browsers cannot set WS headers);\n  a bad/missing token closes the socket with app-level code **4401**.\n\n### WS `/ws/voice` — the voice protocol\nOpenAPI cannot model WebSockets, so the contract is documented here and every\nevent payload is included under **Schemas** below.\n\n* **Binary frames** — client → server: mic audio, PCM16 mono 16 kHz;\n  server → client: TTS audio, PCM16 48 kHz. Audio is never JSON.\n* **Text frames** — JSON control events discriminated by `type`:\n  * client → server: `SessionStart`, `AudioEnd`, `UserInterrupt`, `SessionEnd`, `PhotoUpload`, `PhotoQuality`, `CameraCancelled`, `ChatAnswer`\n  * server → client: `STTPartial`, `STTFinal`, `IntentPartial`, `LLMToken`, `TTSStarted`, `TTSFinished`, `AgentInterrupted`, `LatencyMetrics`, `ErrorEvent`, `ToolRequestPhoto`, `ToolCancelled`, `PhotoReceived`, `DiagnosisStarted`, `CaseDiagnosis`, `ChatQuestion`, `ChatStep`, `ChatState`\n* **Photos** are the one exception to \"binary = mic\": farmer photos ride the\n  JSON plane base64-encoded (`PhotoUpload`) so a still image is never confused\n  with a mic frame.\n* Some events (`usage`, the case-tool events) are emitted as raw dicts on the\n  wire; the models document the exact shapes both sides agreed on.\n* The guided-flow events (`ChatQuestion`/`ChatAnswer`/`ChatStep`/`ChatState`)\n  follow `docs/multichat_contract.md`.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service status and active pipeline",
        "description": "Which voice pipeline is live (Gemini Live vs staged STT→LLM→TTS),\nthe models behind it, and the token prices the client's cost panel\nneeds. No auth.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/crops": {
      "get": {
        "tags": [
          "crops"
        ],
        "summary": "Growz crop catalogue for the mobile picker",
        "description": "Growz crop catalogue for the mobile picker (Uzbek names + real UUIDs).\n\nThe Growz API key stays server-side; the app only ever sees this list.\nFail-open: an empty ``data`` means Growz was unreachable, not an error.",
        "operationId": "crops_crops_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CropsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chats": {
      "get": {
        "tags": [
          "chats"
        ],
        "summary": "List a device's chats (newest first)",
        "description": "Chat summaries for one device (contract §2.1). A corrupt store\nnever 500s — it degrades to an empty list.",
        "operationId": "list_chats_chats_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Stable per-install device id (UUID) that scopes all chat data.",
              "default": "",
              "title": "User Id"
            },
            "description": "Stable per-install device id (UUID) that scopes all chat data."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Max summaries returned (clamped server-side).",
              "default": 50,
              "title": "Limit"
            },
            "description": "Max summaries returned (clamped server-side)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "chats"
        ],
        "summary": "Create an empty chat",
        "description": "Create a chat for the device and return its summary (contract\n§2.2). The chat is bound to a voice session later via\n``SessionStart.chat_id`` on the WebSocket.",
        "operationId": "create_chat_chats_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChatBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{chat_id}": {
      "get": {
        "tags": [
          "chats"
        ],
        "summary": "Fetch one chat with full message history",
        "description": "Full chat detail: messages, last diagnosis and agronom-review state\n(contract §2.3).",
        "operationId": "get_chat_chats__chat_id__get",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chat Id"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Stable per-install device id (UUID) that scopes all chat data.",
              "default": "",
              "title": "User Id"
            },
            "description": "Stable per-install device id (UUID) that scopes all chat data."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "404": {
            "description": "Unknown chat — or owned by another device (never distinguished).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{chat_id}/agronom-request": {
      "post": {
        "tags": [
          "agronom"
        ],
        "summary": "Farmer requests a human-agronom review",
        "description": "Mark the chat's diagnosis as pending expert review (contract P3.3).\nIdempotent: repeat calls while pending/done change nothing. May start\nthe mock AI second-opinion runner (P3.5) when configured.",
        "operationId": "agronom_request_chats__chat_id__agronom_request_post",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chat Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgronomRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "404": {
            "description": "Chat not found, or the agronom feature is disabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{chat_id}/agronom-review": {
      "post": {
        "tags": [
          "agronom"
        ],
        "summary": "Expert submits the agronom verdict",
        "description": "Land the human expert's verdict on a pending review (contract\nP3.4) and append the agronom message to the chat. Expert-only —\ngated by ``X-Agronom-Token``.",
        "operationId": "agronom_review_submit_chats__chat_id__agronom_review_post",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chat Id"
            }
          },
          {
            "name": "x-agronom-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Expert reviewer token (AGRONOM_REVIEW_TOKEN).",
              "title": "X-Agronom-Token"
            },
            "description": "Expert reviewer token (AGRONOM_REVIEW_TOKEN)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgronomReviewBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user_id / verdict, or empty expert_summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "404": {
            "description": "Chat not found, or the agronom feature is disabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "409": {
            "description": "The farmer never requested a review for this chat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },

          "expert_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Expert Notes",
            "description": "Up to 6 notes, ≤300 chars each."
          },
          "adjusted_preparations": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Adjusted Preparations",
            "description": "Frozen P2.1 Preparation shape; [] keeps the AI list."
          }
        },
        "type": "object",
        "title": "AgronomReviewBody",
        "description": "POST /chats/{chat_id}/agronom-review request body (contract P3.4) —\nthe human expert's verdict, submitted with the X-Agronom-Token header."
      },
      "AgronomReviewOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "none | pending | done"
          },
          "requested_at": {
            "type": "string",
            "title": "Requested At"
          },
          "reviewed_at": {
            "type": "string",
            "title": "Reviewed At"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock",
            "description": "True = AI second-opinion stub (P3.5)."
          },
          "verdict": {
            "type": "string",
            "title": "Verdict",
            "description": "\"\" | confirmed | adjusted"
          },
          "expert_summary": {
            "type": "string",
            "title": "Expert Summary"
          },
          "expert_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Expert Notes"
          },
          "adjusted_preparations": {
            "items": {
              "$ref": "#/components/schemas/Preparation"
            },
            "type": "array",
            "title": "Adjusted Preparations",
            "description": "[] means the AI preparations list stands unchanged."
          }
        },
        "type": "object",
        "required": [
          "status",
          "requested_at",
          "reviewed_at",
          "is_mock",
          "verdict",
          "expert_summary",
          "expert_notes",
          "adjusted_preparations"
        ],
        "title": "AgronomReviewOut",
        "description": "§7 agronom verification state, surfaced verbatim on summary + detail."
      },

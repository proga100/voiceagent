            "default": "",
            "examples": [
              "11111111-2222-3333-4444-555555555555"
            ]
          }
        },
        "type": "object",
        "title": "AgronomRequestBody",
        "description": "POST /chats/{chat_id}/agronom-request request body (contract P3.3)."
      },
      "AgronomReviewBody": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",

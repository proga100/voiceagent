            "examples": [
              "11111111-2222-3333-4444-555555555555"
            ]
          },
          "verdict": {
            "type": "string",
            "title": "Verdict",
            "description": "\"confirmed\" or \"adjusted\".",
            "default": ""
          },
          "expert_summary": {
            "type": "string",
            "title": "Expert Summary",
            "description": "Farmer-facing Uzbek summary, ≤600 chars. Required.",
            "default": ""
